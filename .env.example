# Copy this file to .env (in the repo root) and fill in real values.
# backend/app/main.py loads .env automatically via python-dotenv.
#
# Without OPENAI_API_KEY the backend still runs, but /v1/recognize falls
# back to a random mock match instead of calling the vision model — useful
# for frontend/UI work without a key. See README for details.
OPENAI_API_KEY=your-key-here

# Supabase (Postgres + Auth) — Project Settings -> API / Database on
# supabase.com. SUPABASE_URL also derives the JWKS endpoint used to verify
# user JWTs (backend/app/auth.py) -- no separate JWT secret needed, this
# project uses Supabase's newer asymmetric (ES256) signing keys.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-key-here
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@your-pooler-host:5432/postgres
