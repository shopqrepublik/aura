# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/
*.egg-info/
.pytest_cache/

# Environment / secrets
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Redundant archive / stale duplicate — see README, not part of the app
aura-mvp.zip
/aura-mvp/
/main.py

# Real visitor photos used for manual recognition testing — personal photos,
# not project source data, never meant to be committed.
/test_photos/

# Runtime cache — reference images fetched from Wikimedia Commons for the
# hybrid pipeline's visual-verification step (see backend/app/main.py);
# rebuildable, not source data.
/backend/.reference_cache/

# Runtime cache — Recap PNG export's image-proxy endpoint (same rationale
# as .reference_cache/ above, different cache key: URL hash, not artwork id).
/backend/.image_proxy_cache/

# Point-in-time output of backend/scripts/latency_test.py -- rerun the
# script for current numbers rather than trusting a stale committed copy.
/latency_test_results.json

# Louvre importer test-run output (raw/normalized records, checkpoints,
# error logs) -- regenerable from the live source via
# backend/scripts/louvre_import.py, not itself source data. Explicitly NOT
# committed while this pilot is still test-scale and un-reviewed.
/backend/data/louvre/

# Full National Gallery discovery snapshots are reproducible generated data.
# The smaller reviewed benchmark-candidate snapshot is committed explicitly.
/backend/data/onboarding/national_gallery_london/source_snapshot_*.json

.vercel
